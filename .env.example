# Google OAuth 2.0 Web application Client ID.
# Local development reads this file after copying it to .env.
# GitHub Pages deployment should normally set the same value as the repository
# Actions variable VITE_GOOGLE_CLIENT_ID instead of committing .env.
#
# This Client ID is public browser configuration. Never put a client_secret in VITE_*.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# Public browser API key used only by Shared Wallets for Google Picker and
# public encrypted shared-file reads. This is not a secret. Restrict it in
# Google Cloud by HTTP referrer and to the Google Drive API / Google Picker API.
VITE_GOOGLE_API_KEY=your-public-google-api-key
